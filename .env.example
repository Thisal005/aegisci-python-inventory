# Application Configuration
APP_NAME=AegisCI Inventory API
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Database Configuration
# Default: SQLite async database
DATABASE_URL=sqlite+aiosqlite:///./inventory.db
